<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="dashboard-root" xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.fieldsync.controllers.UserRepDashboardController">

    <!-- Left Navigation Bar -->
    <left>
        <VBox styleClass="sidebar">
            <Label text="FS"
                style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #6c5ce7;" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="🏠" styleClass="nav-icon-btn, nav-icon-btn-active" />
            <Button text="⚽" styleClass="nav-icon-btn" onAction="#handleFieldsTab" />
            <Button text="📅" styleClass="nav-icon-btn" onAction="#handleCalendarTab" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="🚪" styleClass="nav-icon-btn" onAction="#handleLogout" />
        </VBox>
    </left>

    <!-- Main Workspace -->
    <center>
        <ScrollPane fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20">
                <padding>
                    <Insets top="24" right="24" bottom="24" left="24" />
                </padding>

                <!-- Top Header Banner -->
                <HBox alignment="CENTER_LEFT" styleClass="bento-card-hero">
                    <VBox spacing="6">
                        <!-- <Label text="TOURNAMENT CONTROL CENTER" styleClass="card-title" /> -->
                        <Label fx:id="lblWelcome" text="WELCOME" styleClass="card-title" />
                        <Label text="Manage venue bookings, team rosters, and match requests."
                            styleClass="card-subtitle" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="+ New Request" styleClass="btn-primary"
                        onAction="#handleNewReservation" />
                </HBox>

                <!-- Bento Cards Layout Grid (2 Columns) -->
                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50.0" />
                        <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>

                    <!-- KPI Card 1: Active Reservations -->
                    <VBox styleClass="bento-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="ACTIVE RESERVATIONS" styleClass="card-subtitle" />
                        <Label fx:id="lblActiveReservations" text="0 Matches" styleClass="kpi-value" />
                        <Label fx:id="lblNextMatch" text="No upcoming matches"
                            styleClass="kpi-trend" />
                    </VBox>

                    <!-- KPI Card 2: Pending Approvals -->
                    <VBox styleClass="bento-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="PENDING APPROVALS" styleClass="card-subtitle" />
                        <Label fx:id="lblPendingApprovals" text="0 Requests" styleClass="kpi-value" />
                        <Label text="Awaiting Registrar review"
                            style="-fx-text-fill: #fdcb6e; -fx-font-size: 12px;" />
                    </VBox>

                    <!-- Venue Reservation Table -->
                    <VBox styleClass="bento-card" GridPane.columnIndex="0" GridPane.columnSpan="2"
                        GridPane.rowIndex="1" spacing="12">
                        <Label text="Venue Reservations" styleClass="card-title" />
                        <TableView fx:id="tblReservations" prefHeight="260">
                            <columns>
                                <TableColumn fx:id="colFieldName" text="Field Name" prefWidth="180" />
                                <TableColumn fx:id="colDate" text="Date" prefWidth="110" />
                                <TableColumn fx:id="colTime" text="Time Slot" prefWidth="140" />
                                <TableColumn fx:id="colPurpose" text="Purpose / Match"
                                    prefWidth="160" />
                                <TableColumn fx:id="colStatus" text="Status" prefWidth="110" />
                                <TableColumn fx:id="colRoster" text="Action" prefWidth="110" />
                            </columns>
                        </TableView>
                    </VBox>
                </GridPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>