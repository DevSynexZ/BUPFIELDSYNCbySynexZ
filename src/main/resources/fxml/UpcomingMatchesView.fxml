<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="dashboard-root" xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.fieldsync.controllers.UpcomingMatchesController">

    <!-- Left Navigation Bar -->
    <left>
        <VBox styleClass="sidebar">
            <Label text="FS" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #6c5ce7;" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="🏠" styleClass="nav-icon-btn" onAction="#handleHomeTab" />
            <Button text="⚽" styleClass="nav-icon-btn" onAction="#handleFieldsTab" />
            <Button text="📅" styleClass="nav-icon-btn, nav-icon-btn-active" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="🚪" styleClass="nav-icon-btn" onAction="#handleLogout" />
        </VBox>
    </left>

    <!-- Main Workspace -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20">
                <padding>
                    <Insets top="24" right="24" bottom="24" left="24" />
                </padding>

                <!-- Top Header Banner -->
                <HBox alignment="CENTER_LEFT" styleClass="bento-card-hero">
                    <VBox spacing="6">
                        <Label text="UPCOMING CONFIRMED MATCHES" styleClass="card-title" />
                        <Label text="View your scheduled matches, countdown hours, and game details." styleClass="card-subtitle" />
                    </VBox>
                </HBox>

                <!-- Table View for Upcoming Matches -->
                <!-- <VBox styleClass="bento-card" spacing="12">
                    <Label text="Scheduled Matches" styleClass="card-title" />
                    <TableView fx:id="tblUpcomingMatches" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="colFieldName" text="Field Name" prefWidth="180" />
                            <TableColumn fx:id="colDate" text="Date" prefWidth="130" />
                            <TableColumn fx:id="colTime" text="Time Slot" prefWidth="150" />
                            <TableColumn fx:id="colPurpose" text="Purpose / Match" prefWidth="180" />
                            <TableColumn fx:id="colCountdown" text="Countdown" prefWidth="140" />
                        </columns>
                    </TableView>
                </VBox> -->
                <VBox styleClass="bento-card" spacing="16">
                    <Label text="Scheduled Match Stream" styleClass="card-title" />
                    
                    <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <HBox fx:id="cardsContainer" spacing="20" alignment="CENTER_LEFT">
                            <padding>
                                <Insets top="8" right="8" bottom="8" left="8" />
                            </padding>
                        </HBox>
                    </ScrollPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>