<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="dashboard-root" xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.fieldsync.controllers.RegistrarDashboardController">

    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar">
            <Label text="REG"
                style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #a29bfe;" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="📊" styleClass="nav-icon-btn, nav-icon-btn-active" />
            <Button text="📋" styleClass="nav-icon-btn" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="🚪" onAction="#handleLogout" styleClass="nav-icon-btn" />
        </VBox>
    </left>

    <!-- Main Workspace -->
    <center>
        <ScrollPane fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20">
                <padding>
                    <Insets top="24" right="24" bottom="24" left="24" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="CAMPUS REGISTRAR DASHBOARD" styleClass="card-title"
                        style="-fx-font-size: 22px;" />
                    <Label fx:id="lblDateRange" text=""
                        style="-fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-font-weight: bold;" />
                </HBox>

                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <!-- Usage Trend Bar Chart -->
                    <VBox styleClass="bento-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label fx:id="lblWeeklyUsageTitle" text="WEEKLY FIELD USAGE" styleClass="card-title" />
                        <BarChart fx:id="chartUsage" prefHeight="240">
                            <xAxis>
                                <CategoryAxis fx:id="axisXDays" label="Date" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Hours Reserved" />
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <!-- Department Allocation Table -->
                    <VBox styleClass="bento-card" GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="10">
                        <Label fx:id="lblDeptAllocationTitle" text="DEPARTMENT ALLOCATION (Past 7 Days)" styleClass="card-title" />
                        <TableView fx:id="tblDepartmentAllocation" prefHeight="240">
                            <columns>
                                <TableColumn fx:id="colDeptName" text="Department" prefWidth="220" />
                                <TableColumn fx:id="colDeptConfirmedCount" text="Confirmed Bookings" prefWidth="180" />
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Pending Approvals Queue -->
                    <VBox styleClass="bento-card" GridPane.columnIndex="0" GridPane.columnSpan="2"
                        GridPane.rowIndex="1" spacing="12">
                        <Label text="PENDING RESERVATION APPROVALS" styleClass="card-title" />
                        <TableView fx:id="tblApprovals" prefHeight="280">
                            <columns>
                                <TableColumn fx:id="colApplicantEmail" text="Representative Email"
                                    prefWidth="180" />
                                <TableColumn fx:id="colFullName" text="Full Name" prefWidth="140" />
                                <TableColumn fx:id="colDepartment" text="Department" prefWidth="120" />
                                <TableColumn fx:id="colDateTime" text="Time Slot" prefWidth="200" />
                                <TableColumn fx:id="colPurpose" text="Purpose" prefWidth="150" />
                                <TableColumn fx:id="colActions" text="Action" prefWidth="160" />
                            </columns>
                        </TableView>
                    </VBox>
                </GridPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>